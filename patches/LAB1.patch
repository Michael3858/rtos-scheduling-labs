+static INT32U OS_JobCnt[OS_LOWEST_PRIO + 1];
+static void OS_TraceCtxSw(void);
+
+static void OS_TraceCtxSw(void)
+{
+    OS_TCB* cur = OSTCBCur;
+    OS_TCB* next = OSTCBHighRdy;
+
+    OS_TCB* idle_tcb = OSTCBPrioTbl[OS_LOWEST_PRIO];
+    INT8U   cur_is_idle = (cur == idle_tcb);
+    INT8U   next_is_idle = (next == idle_tcb);
+
+    INT8U cur_prio = OSPrioCur;
+    INT8U next_prio = OSPrioHighRdy;
+
+    unsigned cur_id_disp = cur_is_idle ? OS_LOWEST_PRIO : (cur ? cur->OSTCBId : 0);
+    unsigned next_id_disp = next_is_idle ? OS_LOWEST_PRIO : (next ? next->OSTCBId : 0);
+
+    unsigned long cur_job = OS_JobCnt[cur_prio];
+    unsigned long next_job = OS_JobCnt[next_prio];
+
+    unsigned long ctx_print = (OSCtxSwCtr > 0u) ? (OSCtxSwCtr - 1u) : 0u;
+
+    if (!cur_is_idle && next_is_idle) {
+        printf("%-4d\ttask(%3d)(%3d)\ttask(%3d)        \t%d\r\n",
+            (unsigned long)OSTime, cur_id_disp, cur_job,
+            next_id_disp, ctx_print);
+
+        if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0) {
+            fprintf(Output_fp, "%-4d\ttask(%3d)(%3d)\ttask(%3d)        \t%d\r\n",
+                (unsigned long)OSTime, cur_id_disp, cur_job,
+                next_id_disp, ctx_print);
+            fclose(Output_fp);
+        }
+    }
+    else if (cur_is_idle && !next_is_idle) {
+        printf("%-4d\ttask(%3d)     \ttask(%3d)(%3d)   \t%d\r\n",
+            (unsigned long)OSTime, cur_id_disp,
+            next_id_disp, next_job, ctx_print);
+
+        if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0) {
+            fprintf(Output_fp, "%-4d\ttask(%3d)     \ttask(%3d)(%3d)   \t%d\r\n",
+                (unsigned long)OSTime, cur_id_disp,
+                next_id_disp, next_job, ctx_print);
+            fclose(Output_fp);
+        }
+    }
+    else if (!cur_is_idle && !next_is_idle) {
+        printf("%-4d\ttask(%3d)(%3d)\ttask(%3d)(%3d)   \t%d\r\n",
+            (unsigned long)OSTime, cur_id_disp, cur_job,
+            next_id_disp, next_job, ctx_print);
+
+        if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0) {
+            fprintf(Output_fp, "%-4d\ttask(%3d)(%3d)\ttask(%3d)(%3d)   \t%d\r\n",
+                (unsigned long)OSTime, cur_id_disp, cur_job,
+                next_id_disp, next_job, ctx_print);
+            fclose(Output_fp);
+        }
+    }
+
+    if (!cur_is_idle) {
+        OS_JobCnt[cur_prio]++;
+    }
+}
 
