+void task(void* p_arg) {
+    task_para_set* task_data;
+    task_data = p_arg;
+    INT8U err;
+
+    for (;;) {
+        OSSemPend(task_data->run_sem, 0, &err);
+
+        if (task_data->active && task_data->rem > 0) {
+            task_data->rem--;
+            if (task_data->rem == 0)
+                task_data->just_finished = 1;
+        }
+    }
+}
