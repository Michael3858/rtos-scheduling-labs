--- a/Microsoft/Windows/Kernel/OS2/app_hooks.c
+++ b/Microsoft/Windows/Kernel/OS2/app_hooks.c
@@ -45,6 +45,92 @@
 */
 
 
+void OutFileInit() {
+    if ((Output_err = fopen_s(&Output_fp, OUTPUT_FILE_NAME, "w") == 0))
+        fclose(Output_fp);
+    else
+        printf("Error to clear output file");
+}
+
+void InputFile() {
+    errno_t err;
+
+    if ((err = fopen_s(&fp, INPUT_FILE_NAME, "r")) == 0)
+        printf("The file '%s' was opened\n", INPUT_FILE_NAME);
+    else 
+        printf("The file %s was not opened", INPUT_FILE_NAME);
+
+    char str[MAX];
+    char* ptr;
+    char* pTmp = NULL;
+    int TaskInfo[INFO], i, j = 0;
+    TASK_NUMBER = 0;
+
+    while (!feof(fp)) {
+        i = 0;
+        memset(str, 0, sizeof(str));
+        fgets(str, sizeof(str) - 1, fp);
+        ptr = strtok_s(str, " ", &pTmp);
+
+        while (ptr != NULL) {
+            TaskInfo[i] = atoi(ptr);
+            ptr = strtok_s(NULL, " ", &pTmp);
+
+            if (i == 0) {
+                TASK_NUMBER++;
+                TaskParameter[j].TaskID = TASK_NUMBER;
+            }
+            else if (i == 1)
+                TaskParameter[j].TaskArriveTime = TaskInfo[i];
+            else if (i == 2)
+                TaskParameter[j].TaskExecutionTIme = TaskInfo[i];
+            else if (i == 3)
+                TaskParameter[j].TaskPeriodic = TaskInfo[i];
+
+            i++;
+        }
+
+        TaskParameter[j].TaskPriority = j;
+
+        j++;
+    }
+
+    fclose(fp);
+
+
+}
+volatile INT32U g_now = 0;
+volatile INT8U g_halt_after_miss = 0;
+static task_para_set* pick_ready_or_arrival(void) {
+    task_para_set* best = NULL;
+    for (int i = 0; i < TASK_NUMBER; i++) {
+        task_para_set* tp = &TaskParameter[i];
+        if ((tp->active && tp->rem > 0) || tp->arrive_now) {
+            if (!best) {
+                best = tp;
+                continue;
+            }
+#if (ALGORITHM == RM)
+            if (tp->TaskPriority < best->TaskPriority)
+                best = tp;
+
+#elif (ALGORITHM == FIFO)
+            INT32U a_rel = (tp->active ? tp->release : g_now);
+            INT32U b_rel = (best->active ? best->release : g_now);
+
+            if (a_rel < b_rel) {
+                best = tp;
+            }
+            else if (a_rel == b_rel && tp->TaskID < best->TaskID) {
+                best = tp;
+            }
+#endif
+        }
+    }
+    return best;
+}
+
+
 /*
 *********************************************************************************************************
 *                                           LOCAL CONSTANTS
@@ -260,6 +346,169 @@ void  App_TimeTickHook (void)
 #if (APP_CFG_PROBE_OS_PLUGIN_EN == DEF_ENABLED) && (OS_PROBE_HOOKS_EN > 0)
     OSProbe_TickHook();
 #endif
+    static task_para_set* prev_win = NULL;  // 記錄上一個 tick 的 winner，用來判斷 Preemption
+
+    if (g_halt_after_miss) return;  // 一旦有過 MissDeadline，就永久停排程
+
+    g_now = OSTimeGet();
+
+    for (int i = 0; i < TASK_NUMBER; i++)
+        TaskParameter[i].arrive_now = 0;
+
+    for (int i = 0; i < TASK_NUMBER; i++) {
+        task_para_set* tp = &TaskParameter[i];
+        if (g_now == tp->next_release) {
+			tp->arrive_now = 1;    // 標記本 tick 有新 job 抵達      
+			tp->next_release += tp->TaskPeriodic;   // 更新下一次抵達時間
+        }
+    }
+
+    // MissDeadline
+    for (int i = 0; i < TASK_NUMBER; i++) {
+        task_para_set* tp = &TaskParameter[i];
+        if (tp->active && tp->rem > 0 && g_now == tp->deadline) {
+            printf("%3d\tMissDeadline  task(%3d)(%3d)\t------------------\n",g_now, tp->TaskID, tp->k);
+            if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0)
+            {
+                fprintf(Output_fp, "%3d\tMissDeadline  task(%3d)(%3d)\t------------------\n", g_now, tp->TaskID, tp->k);
+                fclose(Output_fp);
+            }
+            tp->active = 0;
+            tp->rem = 0;
+            tp->just_finished = 0;
+            tp->preempt_wait = 0;
+            tp->k++;
+            g_halt_after_miss = 1;
+            return;
+        }
+    }
+
+    // Completion
+    for (int i = 0; i < TASK_NUMBER; i++) {
+        task_para_set* tp = &TaskParameter[i];
+        if (!tp->just_finished) continue;
+
+		tp->just_finished = 0;  // 重置旗標
+		tp->active = 0;   // 舊 job 移出 ready
+
+        task_para_set* nxt = pick_ready_or_arrival();
+
+        INT32U resp = g_now - tp->release;   // 完成時間 - 釋出時間 
+        INT32U pree = tp->preempt_wait;    // 被高優先搶占的累積 tick
+		INT32U osdly = (resp >= tp->TaskPeriodic) ? 0 : (tp->TaskPeriodic - resp);  // Deadline - 完成時間
+
+        char cur[24];
+        snprintf(cur, sizeof(cur), "task(%3d)(%3d)",tp->TaskID, tp->k);
+
+        char nextbuf[24];
+        if (nxt) {
+            snprintf(nextbuf, sizeof(nextbuf), "task(%3d)(%3d)",nxt->TaskID, nxt->k);
+        }
+        else {
+            snprintf(nextbuf, sizeof(nextbuf), "task(%3d)", 63);
+        }
+
+        printf("%3d\t%-10s    %-14s\t%-14s\t\t%lu%15lu%15lu\n", g_now, "Completion", cur, nextbuf, resp, pree, osdly);
+        if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0)
+        {
+            fprintf(Output_fp, "%3d\t%-10s    %-14s\t%-14s\t\t%lu%15lu%15lu\n", g_now, "Completion", cur, nextbuf, resp, pree, osdly);
+            fclose(Output_fp);
+        }
+
+        tp->preempt_wait = 0;   
+		tp->k++;  // job 計數++
+    }
+
+    //挑本 tick 的贏家
+    task_para_set* win = NULL;
+
+#if (ALGORITHM == RM)
+    win = pick_ready_or_arrival();
+
+#elif (ALGORITHM == FIFO)
+    if (prev_win && (prev_win->rem > 0)) {
+        win = prev_win;
+    }
+    else {
+        win = pick_ready_or_arrival();
+    }
+#endif
+
+    if (win && win->arrive_now) {
+        win->arrive_now = 0;
+        win->active = 1;
+        win->release = g_now;
+        win->deadline = g_now + win->TaskPeriodic;
+        win->rem = win->TaskExecutionTIme;
+        win->preempt_wait = 0;
+    }
+
+    // 其他剛到達者也設成 ready（但本 tick 不拿 token）
+    for (int i = 0; i < TASK_NUMBER; i++) {
+        task_para_set* tp = &TaskParameter[i];
+        if (tp->arrive_now) {
+            tp->arrive_now = 0;
+            tp->active = 1;
+            tp->release = g_now;
+            tp->deadline = g_now + tp->TaskPeriodic;
+            tp->rem = tp->TaskExecutionTIme;
+        }
+    }
+    if (win == NULL) {  
+        win = pick_ready_or_arrival();
+    }
+
+    // 其餘 ready 的 preempt_wait 累加
+    for (int i = 0; i < TASK_NUMBER; i++) {
+        task_para_set* tp = &TaskParameter[i];
+        if (tp->active && tp->rem > 0 && tp != win) tp->preempt_wait++;
+    }
+
+    // Preemption
+    if (win) {
+        if (prev_win) {
+            // 任務 -> 任務
+            if (win != prev_win && win->TaskPriority < prev_win->TaskPriority && prev_win->rem > 0) {
+                char frombuf[24], tobuf[24];
+                snprintf(frombuf, sizeof(frombuf), "task(%3d)(%3d)", prev_win->TaskID, prev_win->k);
+                snprintf(tobuf, sizeof(tobuf), "task(%3d)(%3d)", win->TaskID, win->k);
+
+                printf("%3d\t%-10s    %-14s\t%-14s\n", g_now, "Preemption", frombuf, tobuf);
+                if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0)
+                {
+                    fprintf(Output_fp, "%3d\t%-10s    %-14s\t%-14s\n", g_now, "Preemption", frombuf, tobuf);
+                    fclose(Output_fp);
+                }
+            }
+        }
+        else {
+            // Idle -> 任務
+            if (g_now > 0) {
+                char tobuf[24];
+                snprintf(tobuf, sizeof(tobuf), "task(%3d)(%3d)", win->TaskID, win->k);
+
+                printf("%3d\t%-10s    %-14s\t%-14s\n", g_now, "Preemption", "task( 63)", tobuf);
+                if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0)
+                {
+                    fprintf(Output_fp, "%3d\t%-10s    %-14s\t%-14s\n", g_now, "Preemption", "task( 63)", tobuf);
+                    fclose(Output_fp);
+                }
+            }
+        }
+        printf("%3d\ttask (%3d) is running\n", g_now, win->TaskID);
+        if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0)
+        {
+            fprintf(Output_fp, "%3d\ttask (%3d) is running\n", g_now, win->TaskID);
+            fclose(Output_fp);
+        }
+    }
+
+    // 發一顆 token
+    if (win && win->run_sem) {
+        OSSemPost(win->run_sem);
+    }
+
+    prev_win = win;  // 記住本 tick 的 winner
 }
 #endif
 #endif
