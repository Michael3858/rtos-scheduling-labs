+        fclose(Output_fp);
+    else
+        printf("Error to clear output file");
+}
+
+extern INT16U  ServerID;
+extern INT16U  ServerSize;
+extern INT16U  AperiodicJobNum;
+extern aperiodic_job_set AperiodicJobs[MAX_APERIODIC_JOBS];
+
+INT8U  CUS_ServerJustDone = 0;     // server 剛在上一個 tick 做完所有 aperiodic
+INT16S CUS_LastJobDone = -1;    // 上一個 tick 結束的 aperiodic job index
+INT32U CUS_ServerResp = 0;
+INT32U CUS_ServerPree = 0;
+
+/* CUS runtime 狀態（只在 EDF + 有 Server 時會用到） */
+static INT8U  CUS_Inited = 0;
+static INT8U  CUS_Backlogged = 0;          /* 是否有 backlog 的 aperiodic job */
+static INT32U CUS_ServerDeadline = 0;          /* CUS 的動態 deadline */
+static INT16S CUS_ServerIdx = -1;         /* 對應到 TaskParameter[] 的哪一個 */
+
+static INT32U CUS_RemExec[MAX_APERIODIC_JOBS];  /* 每個 aperiodic job 剩餘執行時間 */
+static INT8U  CUS_Accepted[MAX_APERIODIC_JOBS]; /* 是否被接受排程 */
+static INT8U  CUS_Finished[MAX_APERIODIC_JOBS]; /* 是否已完成或被 reject */
+
+INT8U  CUS_ServerHasJob = 0;   // 目前這個 server job 是否已有被指派的 aperiodic job
+INT32U CUS_ServerFirstArrive = 0;   // 目前這個 server job 服務的 job 中，最早的抵達時間
+INT32U CUS_ServerExecSum = 0;   // 目前這個 server job 服務的 aperiodic job 總執行時間和
+
+void InputFile() {
+    errno_t err;
+
+    if ((err = fopen_s(&fp, INPUT_FILE_NAME, "r")) == 0)
+        printf("The file '%s' was opened\n", INPUT_FILE_NAME);
+    else 
+        printf("The file %s was not opened", INPUT_FILE_NAME);
+
+    char str[MAX];
+    char* ptr;
+    char* pTmp = NULL;
+    int TaskInfo[INFO], i, j = 0;
+    TASK_NUMBER = 0;
+    ServerID = 0;
+    ServerSize = 0;
+
+    while (!feof(fp)) {
+        i = 0;
+        memset(str, 0, sizeof(str));
+        fgets(str, sizeof(str) - 1, fp);
+        ptr = strtok_s(str, " ", &pTmp);
+
+        while (ptr != NULL && i < INFO) {
+            TaskInfo[i] = atoi(ptr);
+            ptr = strtok_s(NULL, " ", &pTmp);
+            i++;
+        }
+
+        if (i == 2) {
+            ServerID = TaskInfo[0];
+            ServerSize = TaskInfo[1]; 
+        }
+        else if (i >= 4) {
+            TASK_NUMBER++;
+            TaskParameter[j].TaskID = TaskInfo[0];
+            TaskParameter[j].TaskArriveTime = TaskInfo[1];
+            TaskParameter[j].TaskExecutionTIme = TaskInfo[2];
+            TaskParameter[j].TaskPeriodic = TaskInfo[3];
+            TaskParameter[j].TaskPriority = j;
+            if (i >= 8) {
+                TaskParameter[j].R1_lock = TaskInfo[4];
+                TaskParameter[j].R1_unlock = TaskInfo[5];
+                TaskParameter[j].R2_lock = TaskInfo[6];
+                TaskParameter[j].R2_unlock = TaskInfo[7];
+            }
+            else {
+                TaskParameter[j].R1_lock = 0;
+                TaskParameter[j].R1_unlock = 0;
+                TaskParameter[j].R2_lock = 0;
+                TaskParameter[j].R2_unlock = 0;
+            }
+
+            TaskParameter[j].next_release = TaskParameter[j].TaskArriveTime;
+            TaskParameter[j].active = 0;
+            TaskParameter[j].rem = 0;
+            TaskParameter[j].k = 0;
+            TaskParameter[j].arrive_now = 0;
+            TaskParameter[j].preempt_wait = 0;
+            TaskParameter[j].block_wait = 0;   
+            TaskParameter[j].just_finished = 0;
+            TaskParameter[j].run_sem = NULL;
+
+            j++;
+        }
+    }
+    if (ServerID > 0 && ServerSize > 0) {
+        int exists = 0;
+        for (int k = 0; k < TASK_NUMBER; k++) {
+            if (TaskParameter[k].TaskID == ServerID) {
+                exists = 1;
+                break;
+            }
+        }
+
+        if (!exists) {
+            int idx = TASK_NUMBER;
+
+            TaskParameter[idx].TaskID = ServerID;
+            TaskParameter[idx].TaskArriveTime = 0;  
+            TaskParameter[idx].TaskExecutionTIme = 0;  
+            TaskParameter[idx].TaskPeriodic = 0;
+            TaskParameter[idx].TaskPriority = idx; 
+
+            TaskParameter[idx].next_release = 0;
+            TaskParameter[idx].active = 0;
+            TaskParameter[idx].rem = 0;
+            TaskParameter[idx].k = 0;
+            TaskParameter[idx].arrive_now = 0;
+            TaskParameter[idx].preempt_wait = 0;
+            TaskParameter[idx].just_finished = 0;
+            TaskParameter[idx].run_sem = NULL; 
+
+            TASK_NUMBER++;
+        }
+    }
+    fclose(fp);
+}
+void InputAperiodicJobs(void)
+{
+    errno_t err;
+    FILE* afp;
+
+    AperiodicJobNum = 0;
+
+    if ((err = fopen_s(&afp, APERIODIC_FILE_NAME, "r")) != 0) {
+        printf("The file %s was not opened\n", APERIODIC_FILE_NAME);
+        return;
+    }
+    printf("The file '%s' was opened\n", APERIODIC_FILE_NAME);
+
+    char  str[MAX];
+    char* ctx = NULL;
+    int   vals[4];
+
+    while (fgets(str, sizeof(str), afp)) {
+
+        if (str[0] == '\n' || str[0] == '\r' || str[0] == '\0')
+            continue;
+
+        int i = 0;
+        char* tok = strtok_s(str, " ", &ctx);
+        while (tok != NULL && i < 4) {
+            vals[i++] = atoi(tok);
+            tok = strtok_s(NULL, " ", &ctx);
+        }
+
+        if (i == 4 && AperiodicJobNum < MAX_APERIODIC_JOBS) {
+            AperiodicJobs[AperiodicJobNum].job_no = vals[0];
+            AperiodicJobs[AperiodicJobNum].arrive = vals[1];
+            AperiodicJobs[AperiodicJobNum].exec = vals[2];
+            AperiodicJobs[AperiodicJobNum].abs_deadline = vals[3];
+            CUS_RemExec[AperiodicJobNum] = vals[2];
+            CUS_Accepted[AperiodicJobNum] = 0;
+            CUS_Finished[AperiodicJobNum] = 0;
+            AperiodicJobNum++;
+        }
+    }
+
+    fclose(afp);
+}
+
+INT8U R_locked_by[2] = { 0, 0 };   
+INT8U R_ceil_prio[2] = { 255, 255 }; 
+INT8U CPP_base_prio[OS_MAX_TASKS];
+
+extern int TASK_NUMBER;
+extern task_para_set TaskParameter[OS_MAX_TASKS];
+
+static INT8U get_eff_prio(task_para_set* tp)
+{
+    int idx = -1;
+    for (int i = 0; i < TASK_NUMBER; i++) {
+        if (&TaskParameter[i] == tp) {
+            idx = i;
+            break;
+        }
+    }
+
+    INT8U p;
+    if (idx >= 0) {
+        p = CPP_base_prio[idx];
+    }
+    else {
+        p = (INT8U)3;
+    }
+
+#if (PROTOCOL == CPP)
+    for (int r = 0; r < 2; r++) {
+        if (R_locked_by[r] == tp->TaskID) {
+            if (R_ceil_prio[r] < p) {
+                p = R_ceil_prio[r];
+            }
+        }
+    }
+#endif
+
+    return p;
+}
+
+volatile INT32U g_now = 0;
+volatile INT8U g_halt_after_miss = 0;
+static task_para_set* pick_ready_or_arrival(void) {
+    task_para_set* best = NULL;
+    for (int i = 0; i < TASK_NUMBER; i++) {
+        task_para_set* tp = &TaskParameter[i];
+        if ((tp->active && tp->rem > 0) || tp->arrive_now) {
+            if (!best) {
+                best = tp;
+                continue;
+            }
+#if (ALGORITHM == RM)
+    #if (PROTOCOL == CPP)
+                INT8U a_pri = get_eff_prio(tp);
+                INT8U b_pri = get_eff_prio(best);
+    #else
+                INT8U a_pri = tp->TaskPriority;
+                INT8U b_pri = best->TaskPriority;
+    #endif
+
+                INT32U a_rel = (tp->active ? tp->release : g_now);
+                INT32U b_rel = (best->active ? best->release : g_now);
+
+                if (a_pri < b_pri ||
+                    (a_pri == b_pri && a_rel < b_rel) ||
+                    (a_pri == b_pri && a_rel == b_rel && tp->TaskID < best->TaskID)) {
+                    best = tp;
+                }
+
+#elif (ALGORITHM == FIFO)
+            INT32U a_rel = (tp->active ? tp->release : g_now);
+            INT32U b_rel = (best->active ? best->release : g_now);
+
+            if (a_rel < b_rel) {
+                best = tp;
+            }
+            else if (a_rel == b_rel && tp->TaskID < best->TaskID) {
+                best = tp;
+            }
+#elif (ALGORITHM == EDF)
+            INT32U a_dead = tp->deadline;
+            INT32U b_dead = best->deadline;
+
+            if (tp->arrive_now)   a_dead = g_now + tp->TaskPeriodic;
+            if (best->arrive_now) b_dead = g_now + best->TaskPeriodic;
+
+            if (a_dead < b_dead) {
+                best = tp;
+            }
+            else if (a_dead == b_dead && tp->TaskID < best->TaskID) {
+                best = tp;
+            }
+#endif
+        }
+
+    }
+    return best;
+}
+
+/* 找到 server 對應的 TaskParameter[] index（用 ServerID 對 TaskID 比） */
+static void CUS_FindServerIndex(void)
+{
+    if (CUS_ServerIdx >= 0) return;
+
+    for (int i = 0; i < TASK_NUMBER; i++) {
+        if (TaskParameter[i].TaskID == ServerID) {
+            CUS_ServerIdx = i;
+            break;
+        }
+    }
+}
+
+/* 初始化 CUS 的各種狀態，只會在第一次啟動 CUS 時做一次 */
+static void CUS_InitIfNeeded(void)
+{
+    static INT8U inited = 0;
+    if (inited) return;
+    inited = 1;
+
+    CUS_ServerIdx = -1;
+
+    // 在 TaskParameter[] 裡找 TaskID == ServerID 的那一個
+    for (int i = 0; i < TASK_NUMBER; i++) {
+        if (TaskParameter[i].TaskID == ServerID) {
+            CUS_ServerIdx = i;
+            break;
+        }
+    }
+
+    if (CUS_ServerIdx < 0) {
+        printf("ERROR: CUS server task (ID=%d) not found in TaskParameter[]\n", ServerID);
+    }
+
+    // 初始化 CUS 陣列（依你原本的寫法調）
+    for (int j = 0; j < MAX_APERIODIC_JOBS; j++) {
+        CUS_Accepted[j] = 0;
+        CUS_Finished[j] = 0;
+        // CUS_RemExec[j] 應該在讀 AperiodicJobs 時填 exec
+    }
+
+    CUS_Backlogged = 0;
+    CUS_ServerDeadline = 0;
+    CUS_ServerHasJob = 0;
+    CUS_ServerFirstArrive = 0;
+    CUS_ServerExecSum = 0;
+}
+
+/* backlog 總剩餘執行時間 */
+static INT32U CUS_TotalRemExec(void)
+{
+    INT32U sum = 0;
+    for (int j = 0; j < AperiodicJobNum && j < MAX_APERIODIC_JOBS; j++) {
+        if (CUS_Accepted[j] && !CUS_Finished[j]) {
+            sum += CUS_RemExec[j];
+        }
+    }
+    return sum;
+}
+
+/* backlog 中最小 absolute deadline */
+static INT32U CUS_MinAbsDeadline(void)
+{
+    INT32U best = 0xFFFFFFFF;
+    for (int j = 0; j < AperiodicJobNum && j < MAX_APERIODIC_JOBS; j++) {
+        if (CUS_Accepted[j] && !CUS_Finished[j]) {
+            if (AperiodicJobs[j].abs_deadline < best)
+                best = AperiodicJobs[j].abs_deadline;
+        }
+    }
+    return best;
+}
+
+INT32U CUS_NewServerDeadline(INT32U now, INT32U rem_total)
+{
+    if (ServerSize == 0) {
+        return now + rem_total;
+    }
+    INT32U num = (INT32U)rem_total * 100ULL;
+    INT32U delta = (INT32U)(num / (INT32U)ServerSize);
+    return now + delta;
+}
+
+/* 從 backlog 中選要服務的 aperiodic job：用最早 abs deadline 當 tie-break */
+static INT16S CUS_PickJob(void)
+{
+    INT16S best_idx = -1;
+    INT32U best_dl = 0xFFFFFFFF;
+
+    for (int j = 0; j < AperiodicJobNum && j < MAX_APERIODIC_JOBS; j++) {
+        if (CUS_Accepted[j] && !CUS_Finished[j] && CUS_RemExec[j] > 0) {
+            if (AperiodicJobs[j].abs_deadline < best_dl) {
+                best_dl = AperiodicJobs[j].abs_deadline;
+                best_idx = (INT16S)j;
+            }
+        }
+    }
+    return best_idx;
+}
+
+// 等待中的 job：還沒被 CUS 接受 (Accepted=0)、也沒被丟掉 (Finished=0)
+static INT16S CUS_PickWaitingJob(void)
+{
+    INT32U best_dl = 0xFFFFFFFF;
+    INT16S best_j = -1;
+
+    for (int j = 0; j < AperiodicJobNum && j < MAX_APERIODIC_JOBS; j++) {
+        if (!CUS_Finished[j] && !CUS_Accepted[j] && AperiodicJobs[j].arrive <= g_now) {
+            if (AperiodicJobs[j].abs_deadline < best_dl) {
+                best_dl = AperiodicJobs[j].abs_deadline;
+                best_j = j;
+            }
+        }
+    }
+    return best_j;
+}
+
+typedef struct {
+    INT8U  locked;       // 0: free, 1: locked
+    INT16U ownerTaskID;  // 哪個 TaskID 持有
+} RES_INFO;
+
+RES_INFO g_res[2];       // g_res[0] = R1, g_res[1] = R2
+INT16U   g_cs_ownerID = 0;   // 目前在 critical section 裡的 TaskID，0 = 沒有
+INT8U  g_cs_nesting = 0;   // 同一個 task 的巢狀 lock 次數（避免 R1、R2 解鎖順序問題）
+
+void NPCS_Init(void)
+{
+    for (int i = 0; i < 2; i++) {
+        g_res[i].locked = 0;
+        g_res[i].ownerTaskID = 0;
+    }
+    g_cs_ownerID = 0;
+}
+
+static void NPCS_Lock(INT8U res_idx, task_para_set* tp, INT32U now)
+{
+    if (g_res[res_idx].locked == 0) {
+        g_res[res_idx].locked = 1;
+        g_res[res_idx].ownerTaskID = tp->TaskID;
+        if (g_cs_ownerID == 0) {
+            g_cs_ownerID = tp->TaskID;
+        }
+
+        char cur[24];
+        snprintf(cur, sizeof(cur), "task(%3d)(%3d)", tp->TaskID, tp->k);
+
+        printf("%3lu\t%-10s    %-14s\tR%d\n", (unsigned long)now, "LockResource", cur, res_idx + 1);
+
+        if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0) {
+            fprintf(Output_fp, "%3lu\t%-10s    %-14s\tR%d\n", (unsigned long)now, "LockResource", cur, res_idx + 1);
+            fclose(Output_fp);
+        }
+    }
+}
+
+static void NPCS_Unlock(INT8U res_idx, task_para_set* tp, INT32U now)
+{
+    if (g_res[res_idx].locked && g_res[res_idx].ownerTaskID == tp->TaskID) {
+        g_res[res_idx].locked = 0;
+        g_res[res_idx].ownerTaskID = 0;
+        INT8U still_holding = 0;
+        for (int i = 0; i < 2; i++) { 
+            if (g_res[i].locked && g_res[i].ownerTaskID == tp->TaskID) {
+                still_holding = 1;
+                break;
+            }
+        }
+        if (!still_holding && g_cs_ownerID == tp->TaskID) {
+            g_cs_ownerID = 0; 
+        }
+        char cur[24];
+        snprintf(cur, sizeof(cur), "task(%3d)(%3d)", tp->TaskID, tp->k);
+        printf("%3lu\t%-10s    %-14s\tR%d\n", (unsigned long)now, "UnlockResource", cur, res_idx + 1);
+        if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0) {
+            fprintf(Output_fp, "%3lu\t%-10s    %-14s\tR%d\n", (unsigned long)now, "UnlockResource", cur, res_idx + 1);
+            fclose(Output_fp);
+        }
+    }
+}
+
+void CPP_InitCeiling(void)
+{
+    for (int i = 0; i < TASK_NUMBER; i++) {
+        task_para_set* tp = &TaskParameter[i];
+        int rank = 1;
+        for (int j = 0; j < TASK_NUMBER; j++) {
+            if (i == j) continue;
+            task_para_set* tp_j = &TaskParameter[j];
+
+            if (tp_j->TaskPeriodic < tp->TaskPeriodic) {
+                rank++;
+            }
+            else if (tp_j->TaskPeriodic == tp->TaskPeriodic &&
+                tp_j->TaskID < tp->TaskID) {
+                rank++;
+            }
+        }
+        CPP_base_prio[i] = (INT8U)(rank * 3);
+    }
+
+    R_ceil_prio[0] = 255;
+    R_ceil_prio[1] = 255;
+
+    for (int i = 0; i < TASK_NUMBER; i++) {
+        task_para_set* tp = &TaskParameter[i];
+        INT8U base_p = CPP_base_prio[i];
+
+        if (tp->R1_lock > 0) {
+            if (base_p < R_ceil_prio[0]) {
+                R_ceil_prio[0] = base_p;
+            }
+        }
+        if (tp->R2_lock > 0) {
+            if (base_p < R_ceil_prio[1]) {
+                R_ceil_prio[1] = base_p;
+            }
+        }
+    }
+
+    if (R_ceil_prio[0] != 255 && R_ceil_prio[0] > 1) {
+        R_ceil_prio[0] -= 1;  
+    }
+    if (R_ceil_prio[1] != 255 && R_ceil_prio[1] > 2) {
+        R_ceil_prio[1] -= 2; 
+    }
+
+    R_locked_by[0] = 0;
+    R_locked_by[1] = 0;
+}
+
+void CPP_Lock(int res_id, task_para_set* tp, INT32U now)
+{
+    INT8U old_p = get_eff_prio(tp);
+    R_locked_by[res_id] = tp->TaskID;
+    INT8U new_p = get_eff_prio(tp);
+
+    printf("%3lu\t%-10s    task(%3d)(%3d)\tR%d %u to %u\n",
+        (unsigned long)now, "LockResource",
+        tp->TaskID, tp->k,
+        res_id + 1, old_p, new_p);
+
+    if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0) {
+        fprintf(Output_fp, "%3lu\t%-10s    task(%3d)(%3d)\tR%d %u to %u\n",
+            (unsigned long)now, "LockResource",
+            tp->TaskID, tp->k,
+            res_id + 1, old_p, new_p);
+        fclose(Output_fp);
+    }
+}
+
+void CPP_Unlock(int res_id, task_para_set* tp, INT32U now)
+{
+    INT8U old_p = get_eff_prio(tp);
+    R_locked_by[res_id] = 0;
+    INT8U new_p = get_eff_prio(tp);
+
+    printf("%3lu\t%-10s    task(%3d)(%3d)\tR%d %u to %u\n",
+        (unsigned long)now, "UnlockResource",
+        tp->TaskID, tp->k,
+        res_id + 1, old_p, new_p);
+
+    if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0) {
+        fprintf(Output_fp, "%3lu\t%-10s    task(%3d)(%3d)\tR%d %u to %u\n",
+            (unsigned long)now, "UnlockResource",
+            tp->TaskID, tp->k,
+            res_id + 1, old_p, new_p);
+        fclose(Output_fp);
+    }
+}
