+            resp = g_now - sp->release;
+            pree = sp->preempt_wait;
+        }
+        task_para_set* nxt = pick_ready_or_arrival();
+
+        char cur[24], nextbuf[24];
+        snprintf(cur, sizeof(cur), "task(%3d)(%3d)", sp->TaskID, sp->k);
+
+        if (nxt) {
+            snprintf(nextbuf, sizeof(nextbuf), "task(%3d)(%3d)",
+                nxt->TaskID, nxt->k);
+        }
+        else {
+            snprintf(nextbuf, sizeof(nextbuf), "task(%3d)", 63);
+        }
+
+        printf("%3d\t%-10s    %-14s\t%-14s\t\t%lu%15lu%15s\n",
+            g_now, "Completion", cur, nextbuf, resp, pree, "N/A");
+        if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0) {
+            fprintf(Output_fp, "%3d\t%-10s    %-14s\t%-14s\t\t%lu%15lu%15s\n",
+                g_now, "Completion", cur, nextbuf, resp, pree, "N/A");
+            fclose(Output_fp);
+        }
+
+        sp->preempt_wait = 0;
+        sp->k++;
+
+        CUS_ServerJustDone = 0;
+        CUS_ServerHasJob = 0;
+        CUS_ServerExecSum = 0;
+        CUS_ServerFirstArrive = 0;
+    }
+#endif
+#if (PROTOCOL == NPCS)
+    if (prev_win && prev_win->active && prev_win->rem > 0) {
+
+        INT16U exec_so_far = prev_win->TaskExecutionTIme - prev_win->rem;
+
+        // Unlock
+        if (prev_win->R1_unlock > 0 && exec_so_far == prev_win->R1_unlock)
+            NPCS_Unlock(0, prev_win, g_now);
+
+        if (prev_win->R2_unlock > 0 && exec_so_far == prev_win->R2_unlock)
+            NPCS_Unlock(1, prev_win, g_now);
+    }
+#elif (PROTOCOL == CPP)
+    if (prev_win && prev_win->active && prev_win->rem > 0) {
+        INT16U exec_so_far = prev_win->TaskExecutionTIme - prev_win->rem;
+
+        if (prev_win->R1_unlock > 0 && exec_so_far == prev_win->R1_unlock)
+            CPP_Unlock(0, prev_win, g_now);
+        if (prev_win->R2_unlock > 0 && exec_so_far == prev_win->R2_unlock)
+            CPP_Unlock(1, prev_win, g_now);
+
+        if (prev_win->R1_lock > 0 && exec_so_far == prev_win->R1_lock)
+            CPP_Lock(0, prev_win, g_now);
+        if (prev_win->R2_lock > 0 && exec_so_far == prev_win->R2_lock)
+            CPP_Lock(1, prev_win, g_now);
+    }
+#endif
+    //挑本 tick 的贏家
+    task_para_set* win = NULL;
+
+#if (ALGORITHM == RM)
+
+#if (PROTOCOL == NPCS)
+    if (g_cs_ownerID != 0) {
+        task_para_set* owner = NULL;
+        for (int i = 0; i < TASK_NUMBER; i++) {
+            if (TaskParameter[i].TaskID == g_cs_ownerID) {
+                owner = &TaskParameter[i];
+                break;
+            }
+        }
+
+        if (owner && owner->active && owner->rem > 0) {
+            win = owner;
+        }
+        else {
+            g_cs_ownerID = 0;
+        }
+    }
+#endif
+    if (win == NULL) {
+        win = pick_ready_or_arrival();
+    }
+    
+#elif (ALGORITHM == FIFO)
+    if (prev_win && (prev_win->rem > 0)) {
+        win = prev_win;
+    }
+    else {
+        win = pick_ready_or_arrival();
+    }
+#elif (ALGORITHM == EDF)
+    win = pick_ready_or_arrival();
+#endif
+
+    if (win && win->arrive_now) {
+        win->arrive_now = 0;
+        win->active = 1;
+        win->release = g_now;
+        win->rem = win->TaskExecutionTIme;
+        win->preempt_wait = 0;
+#if (ALGORITHM == EDF)
+        if (cus_enabled && CUS_ServerIdx >= 0 && win->TaskID == ServerID && CUS_Backlogged) {
+            win->deadline = CUS_ServerDeadline;
+        }
+        else
+#endif
+        {
+            win->deadline = g_now + win->TaskPeriodic;
+        }
+    }
+
+    // 其他剛到達者也設成 ready（但本 tick 不拿 token）
+    for (int i = 0; i < TASK_NUMBER; i++) {
+        task_para_set* tp = &TaskParameter[i];
+        if (tp->arrive_now) {
+            tp->arrive_now = 0;
+            tp->active = 1;
+            tp->release = g_now;
+            tp->rem = tp->TaskExecutionTIme;
+            tp->preempt_wait = 0;
+#if (ALGORITHM == EDF)
+            if (cus_enabled && CUS_ServerIdx >= 0 && tp->TaskID == ServerID && CUS_Backlogged) {
+                tp->deadline = CUS_ServerDeadline;
+            }
+            else
+#endif
+            {
+                tp->deadline = g_now + tp->TaskPeriodic;
+            }
+        }
+    }
+    if (win == NULL) {  
+        win = pick_ready_or_arrival();
+    }
+#if (PROTOCOL == NPCS)
+    if (win && win->active && win->rem > 0) {
+
+        INT16U exec_so_far = win->TaskExecutionTIme - win->rem;
+
+        if (win->R1_lock > 0 && exec_so_far == win->R1_lock)
+            NPCS_Lock(0, win, g_now);
+
+        if (win->R2_lock > 0 && exec_so_far == win->R2_lock)
+            NPCS_Lock(1, win, g_now);
+    }
+#endif
+    // 其餘 ready job：累計 Blocking / Preemption
+    for (int i = 0; i < TASK_NUMBER; i++) {
+        task_para_set* tp = &TaskParameter[i];
+        if (!tp->active || tp->rem <= 0 || tp == win) continue;
+
+#if (ALGORITHM == RM)
+
+#if (PROTOCOL == NPCS)
+        if (g_cs_ownerID != 0 && win && win->TaskID == g_cs_ownerID && tp->TaskPriority < win->TaskPriority) {
+            tp->block_wait++;
+        }
+        else if (tp->TaskPriority > win->TaskPriority) {
+            tp->preempt_wait++;
+        }
+#elif (PROTOCOL == CPP)
+        INT8U win_p = get_eff_prio(win);
+        INT8U tp_p = get_eff_prio(tp);
+
+        INT8U win_base = 0xFF;
+        INT8U tp_base = 0xFF;
+        for (int k = 0; k < TASK_NUMBER; k++) {
+            if (&TaskParameter[k] == win) win_base = CPP_base_prio[k];
+            if (&TaskParameter[k] == tp)  tp_base = CPP_base_prio[k];
+        }
+
+        if (tp_base < win_base && tp_p > win_p) {
+            tp->block_wait++;
+        }
+        else if (tp_p > win_p) {
+            tp->preempt_wait++;
+        }
+#else
+        if (tp->TaskPriority > win->TaskPriority) {
+            tp->preempt_wait++;
+        }
+#endif
+
+#else  
+        tp->preempt_wait++;
+#endif
+    }
+
+    // Preemption
+    if (win) {
+        if (prev_win) {
+            INT8U higher = 0;
+
+#if (ALGORITHM == RM) || (ALGORITHM == FIFO)
+
+#if (PROTOCOL == CPP)
+            INT8U win_p = get_eff_prio(win);
+            INT8U prev_p = get_eff_prio(prev_win);
+
+            if (win_p < prev_p) {
+                higher = 1;
+            }
+#elif (PROTOCOL == NPCS)
+            if (win->TaskPriority < prev_win->TaskPriority) {
+                higher = 1;
+            }
+#else
+            if (win->TaskPriority < prev_win->TaskPriority) {
+                higher = 1;
+            }
+#endif
+#elif (ALGORITHM == EDF)
+            INT32U win_dead = win->deadline;
+            INT32U prev_dead = prev_win->deadline;
+
+            if (win_dead < prev_dead || (win_dead == prev_dead && win->TaskID < prev_win->TaskID)) {
+                higher = 1;
+            }
+#endif
+            // 任務 -> 任務 的 Preemption
+            if (win != prev_win && higher && prev_win->rem > 0 &&
+                prev_win->active && prev_win->release < g_now) {
+                char frombuf[24], tobuf[24];
+                snprintf(frombuf, sizeof(frombuf), "task(%3d)(%3d)", prev_win->TaskID, prev_win->k);
+                snprintf(tobuf, sizeof(tobuf), "task(%3d)(%3d)", win->TaskID, win->k);
+
+                printf("%3d\t%-10s    %-14s\t%-14s\n",
+                    g_now, "Preemption", frombuf, tobuf);
+                if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0) {
+                    fprintf(Output_fp, "%3d\t%-10s    %-14s\t%-14s\n",
+                        g_now, "Preemption", frombuf, tobuf);
+                    fclose(Output_fp);
+                }
+            }
+        }
+        else {
+            // Idle -> 任務
+            if (g_now > 0) {
+                char tobuf[24];
+                snprintf(tobuf, sizeof(tobuf), "task(%3d)(%3d)", win->TaskID, win->k);
+
+                printf("%3d\t%-10s    %-14s\t%-14s\n",
+                    g_now, "Preemption", "task( 63)", tobuf);
+                if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0) {
+                    fprintf(Output_fp, "%3d\t%-10s    %-14s\t%-14s\n",
+                        g_now, "Preemption", "task( 63)", tobuf);
+                    fclose(Output_fp);
+                }
+            }
+        }
+
+#if (ALGORITHM == EDF)
+        if (cus_enabled && CUS_ServerIdx >= 0 && CUS_ServerResp > 0) {
+            task_para_set* sp = &TaskParameter[CUS_ServerIdx];
+
+            task_para_set* nxt = win;
+
+            char cur[24], nextbuf[24];
+            snprintf(cur, sizeof(cur), "task(%3d)(%3d)", sp->TaskID, sp->k - 1); 
+
+            if (nxt)
+                snprintf(nextbuf, sizeof(nextbuf), "task(%3d)(%3d)", nxt->TaskID, nxt->k);
+            else
+                snprintf(nextbuf, sizeof(nextbuf), "task(%3d)", 63);
+
+            printf("%3d\t%-10s    %-14s\t%-14s\t\t%lu%15lu%15s\n",
+                g_now, "Completion", cur, nextbuf,
+                CUS_ServerResp, CUS_ServerPree, "N/A");
+            if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0) {
+                fprintf(Output_fp, "%3d\t%-10s    %-14s\t%-14s\t\t%lu%15lu%15s\n",
+                    g_now, "Completion", cur, nextbuf,
+                    CUS_ServerResp, CUS_ServerPree, "N/A");
+                fclose(Output_fp);
+            }
+
+            CUS_ServerResp = 0;
+            CUS_ServerPree = 0;
+        }
+#endif
+
+        /* ---------- Running 印出（這裡加上 CUS 在 server 時服務 job） ---------- */
+#if (ALGORITHM == EDF)
+        if (cus_enabled && CUS_ServerIdx >= 0 &&
+            win->TaskID == ServerID && CUS_Backlogged) {
+            INT16S jj = CUS_PickJob();
+            if (jj >= 0) {
+                CUS_RemExec[jj]--;
+                printf("%3d\tAperiodic job (%d) is running\n",
+                    g_now, AperiodicJobs[jj].job_no);
+                if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0) {
+                    fprintf(Output_fp, "%3d\tAperiodic job (%d) is running\n",
+                        g_now, AperiodicJobs[jj].job_no);
+                    fclose(Output_fp);
+                }
+
+                if (CUS_RemExec[jj] == 0) {
+                    CUS_Finished[jj] = 1;
+                    CUS_LastJobDone = jj;
+
+                    // 如果所有 aperiodic job 都做完 → 下一個 tick 印 server Completion
+                    if (CUS_TotalRemExec() == 0) {
+                        CUS_Backlogged = 0;
+                        CUS_ServerJustDone = 1;
+                    }
+                }
+            }
+        }
+        else {
+            printf("%3d\tTask (%3d) is running\n", g_now, win->TaskID);
+            if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0) {
+                fprintf(Output_fp, "%3d\tTask (%3d) is running\n", g_now, win->TaskID);
+                fclose(Output_fp);
+            }
+        }
+#else
+        printf("%3d\tTask (%3d) is running\n", g_now, win->TaskID);
+        if ((Output_err = fopen_s(&Output_fp, "./Output.txt", "a")) == 0) {
+            fprintf(Output_fp, "%3d\tTask (%3d) is running\n", g_now, win->TaskID);
+            fclose(Output_fp);
+        }
+#endif
+    }
+
+    // 發一顆 token
+    if (win && win->run_sem) {
+        OSSemPost(win->run_sem);
+    }
+
+    prev_win = win;  // 記住本 tick 的 winner
 }
 #endif
 #endif
